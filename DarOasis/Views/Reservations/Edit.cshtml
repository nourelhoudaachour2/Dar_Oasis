@model DarOasis.Models.Reservation

@{
    ViewData["Title"] = "Modifier Réservation";
}

<div class="page-container">

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:30px;">
        <div>
            <h1 class="page-title">Modifier <span>Réservation</span></h1>
            <p class="page-subtitle">Modifier les informations de la réservation</p>
            <div class="title-divider"></div>
        </div>

        <a asp-action="Index" class="btn btn-outline">Retour</a>
    </div>

    <div class="card" style="padding:40px;">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="IdReservation" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:22px;">

                <div class="info-box">
                    <label class="info-label">CLIENT</label>
                    <select asp-for="ClientId" class="form-control" asp-items="ViewBag.ClientId"></select>
                </div>

                <div class="info-box">
                    <label class="info-label">CHAMBRE</label>
                    <select asp-for="ChambreId" id="ChambreId" class="form-control" asp-items="ViewBag.ChambreId"></select>
                </div>

                <div class="info-box">
                    <label class="info-label">DATE DÉBUT</label>
                    <input asp-for="DateDebut" id="DateDebut" type="date" class="form-control" />
                </div>

                <div class="info-box">
                    <label class="info-label">DATE FIN</label>
                    <input asp-for="DateFin" id="DateFin" type="date" class="form-control" />
                </div>

                <div class="info-box">
                    <label class="info-label">NOMBRE DE JOURS</label>
                    <input asp-for="NombreJours" id="NombreJours" class="form-control" />
                </div>

                <div class="info-box">
                    <label class="info-label">PRIX TOTAL</label>
                    <input asp-for="PrixTotal"
                           id="PrixTotal"
                           type="number"
                           step="0.1"
                           value="@Model.PrixTotal.ToString("0.0").Replace(",", ".")"
                           class="form-control" />
                </div>

            </div>

            <div style="margin-top:40px;">
                <h2 style="font-size:34px;color:#6B3A13;margin-bottom:20px;">
                    Accompagnants
                </h2>

                @if (Model.Accompagnants != null && Model.Accompagnants.Any())
                {
                    @for (int i = 0; i < Model.Accompagnants.Count; i++)
                    {
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:14px;margin-bottom:18px;background:#FBF8F2;border:1px solid #E7D7B5;padding:18px;border-radius:16px;">

                            <input type="hidden"
                                   name="Accompagnants[@i].Id"
                                   value="@Model.Accompagnants.ElementAt(i).Id" />

                            <div>
                                <label class="info-label">NOM</label>
                                <input name="Accompagnants[@i].Nom"
                                       value="@Model.Accompagnants.ElementAt(i).Nom"
                                       class="form-control" />
                            </div>

                            <div>
                                <label class="info-label">PRÉNOM</label>
                                <input name="Accompagnants[@i].Prenom"
                                       value="@Model.Accompagnants.ElementAt(i).Prenom"
                                       class="form-control" />
                            </div>

                            <div>
                                <label class="info-label">DATE NAISSANCE</label>
                                <input type="date"
                                       name="Accompagnants[@i].DateNaissance"
                                       value="@Model.Accompagnants.ElementAt(i).DateNaissance.ToString("yyyy-MM-dd")"
                                       class="form-control" />
                            </div>

                            <div style="display:flex;align-items:end;">
                                <button type="button"
                                        onclick="supprimerBloc(this)"
                                        style="background:#E86C4F;color:white;border:none;padding:12px 16px;border-radius:12px;cursor:pointer;font-weight:700;">
                                    Supprimer
                                </button>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <p style="color:#9B7B5A;font-weight:600;">Aucun accompagnant.</p>
                }
            </div>

            <div style="margin-top:40px;">
                <h2 style="font-size:34px;color:#6B3A13;margin-bottom:20px;">
                    Services supplémentaires
                </h2>

                @{
                    var services = ViewBag.Services as List<DarOasis.Models.ServiceSupplementaire>;
                    var servicesSelectionnes = Model.ReservationServices != null
                        ? Model.ReservationServices.Select(rs => rs.ServiceId).ToList()
                        : new List<int>();
                }

                @if (services != null && services.Any())
                {
                    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;">
                        @foreach (var service in services)
                        {
                            <label style="background:#FBF8F2;border:1px solid #EDE0C4;border-radius:14px;padding:14px;display:flex;align-items:center;gap:10px;cursor:pointer;">

                                <input type="checkbox"
                                       name="ServicesIds"
                                       value="@service.IdService"
                                @(servicesSelectionnes.Contains(service.IdService) ? "checked" : "") />

                                <span style="font-weight:700;color:#5C3317;">
                                    @service.NomService
                                </span>

                                <span style="margin-left:auto;color:#C8922A;font-weight:800;">
                                    @service.PrixService.ToString("0.0") TND / jour
                                </span>

                            </label>
                        }
                    </div>
                }
                else
                {
                    <p style="color:#9B7B5A;font-weight:600;">Aucun service disponible.</p>
                }
            </div>

            <div style="margin-top:35px;display:flex;gap:12px;">
                <button type="submit"
                        style="background:#7B8D3D;color:white;border:none;padding:14px 30px;border-radius:16px;font-size:17px;font-weight:700;cursor:pointer;">
                    Enregistrer
                </button>

                <a asp-action="Index" class="btn btn-outline">Retour</a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function supprimerBloc(button) {
            button.closest("div[style*='grid-template-columns']").remove();
        }

        const dateDebut = document.getElementById("DateDebut");
        const dateFin = document.getElementById("DateFin");
        const prixInput = document.getElementById("PrixTotal");
        const nombreJoursInput = document.getElementById("NombreJours");
        const chambreSelect = document.getElementById("ChambreId");

        async function recalculPrix() {
            const chambreId = chambreSelect.value;

            if (!dateDebut.value || !dateFin.value || !chambreId)
                return;

            const debut = new Date(dateDebut.value);
            const fin = new Date(dateFin.value);

            const diff = Math.ceil((fin - debut) / (1000 * 60 * 60 * 24));

            if (diff <= 0)
                return;

            nombreJoursInput.value = diff;

            const response = await fetch(`/Chambres/GetPrix/${chambreId}`);

            if (!response.ok)
                return;

            const prixParNuit = await response.json();

            let coefficient = 1;
            const mois = debut.getMonth() + 1;

            if (mois == 6 || mois == 7 || mois == 8)
                coefficient = 1.5;
            else if (mois == 5 || mois == 12)
                coefficient = 1.3;

            prixInput.value = (diff * prixParNuit * coefficient).toFixed(1);
        }

        dateDebut.addEventListener("change", recalculPrix);
        dateFin.addEventListener("change", recalculPrix);
        chambreSelect.addEventListener("change", recalculPrix);
    </script>
}