<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Dar Oasis</title>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Lato', sans-serif;
            background: #F8F3EA;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar {
            background: #fff;
            border-bottom: 1.5px solid #EDE0C4;
            padding: 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 70px;
            box-shadow: 0 2px 12px rgba(92,51,23,.06);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-brand img { height: 90px; }

        .nav-role {
            font-size: 11px;
            background: #F5EDD6;
            color: #8B5A2B;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .nav-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #5C3317;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
        }

        .btn-logout {
            font-size: 13px;
            color: #A03A1E;
            background: #FFF0EC;
            border: 1px solid #F5C4B3;
            border-radius: 8px;
            padding: 8px 18px;
            cursor: pointer;
            font-family: 'Lato', sans-serif;
            font-weight: 700;
            text-decoration: none;
            transition: background .2s;
        }

        .btn-logout:hover { background: #F5C4B3; }

        .layout { display: flex; flex: 1; }

        .sidebar {
            width: 230px;
            background: #fff;
            border-right: 1px solid #EDE0C4;
            padding: 24px 12px;
            display: flex;
            flex-direction: column;
            gap: 2px;
            position: sticky;
            top: 70px;
            height: calc(100vh - 70px);
            overflow-y: auto;
        }

        .sidebar-section {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: #9B7B5A;
            padding: 10px 12px 4px;
            font-weight: 700;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 13px;
            color: #6B4423;
            transition: all .2s;
            text-decoration: none;
            font-weight: 400;
        }

        .sidebar-item:hover { background: #FBF6EC; color: #5C3317; }
        .sidebar-item.active { background: #F5EDD6; color: #5C3317; font-weight: 700; }

        .sidebar-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .icon-brown   { background: #F0E8DC; }
        .icon-olive   { background: #EBF0DC; }
        .icon-mustard { background: #F5EED8; }
        .icon-terra   { background: #F5E8E0; }
        .sidebar-icon svg { width: 16px; height: 16px; }

        .main-content { flex: 1; padding: 30px 36px; overflow: auto; }

        .page-title { font-size: 26px; color: #5C3317; font-weight: 700; }
        .page-title span { color: #C47A5A; }
        .page-subtitle { font-size: 13px; color: #9B7B5A; margin-top: 4px; }

        .title-divider {
            width: 40px; height: 3px;
            background: linear-gradient(90deg, #C8922A, #C47A5A);
            border-radius: 2px;
            margin-top: 8px; margin-bottom: 24px;
        }

        .card { background: #fff; border-radius: 16px; padding: 24px; border: 1px solid #EDE0C4; }

        .btn {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 9px 18px; border-radius: 10px; font-size: 13px;
            font-weight: 700; cursor: pointer; border: none;
            font-family: 'Lato', sans-serif; text-decoration: none; transition: all .18s;
        }

        .btn-primary { background: #5C3317; color: #fff; }
        .btn-primary:hover { background: #8B5A2B; }
        .btn-olive { background: #6B7C3E; color: #fff; }
        .btn-olive:hover { background: #8FA44E; }
        .btn-mustard { background: #C8922A; color: #fff; }
        .btn-mustard:hover { background: #E8B84B; }
        .btn-danger { background: #FFF0EC; color: #A03A1E; border: 1px solid #F5C4B3; }
        .btn-danger:hover { background: #F5C4B3; }
        .btn-outline { background: transparent; border: 1.5px solid #5C3317; color: #5C3317; }
        .btn-outline:hover { background: #F5EDD6; }

        .table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .table th { font-size: 11px; text-transform: uppercase; letter-spacing: .8px; color: #9B7B5A; font-weight: 700; padding: 10px 14px; text-align: left; border-bottom: 1px solid #EDE0C4; }
        .table td { padding: 12px 14px; color: #3A2010; border-bottom: .5px solid #F5EDD6; }
        .table tr:last-child td { border-bottom: none; }
        .table tr:hover td { background: #FBF8F2; }

        .form-label { display: block; font-size: 11px; font-weight: 700; color: #6B4423; text-transform: uppercase; letter-spacing: .8px; margin-bottom: 6px; margin-top: 18px; }
        .form-control { width: 100%; padding: 11px 14px; border: 1.5px solid #EDE0C4; border-radius: 10px; font-size: 14px; font-family: 'Lato', sans-serif; color: #3A2010; background: #FBF8F2; transition: border .2s; }
        .form-control:focus { outline: none; border-color: #C8922A; background: #fff; }
    </style>
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar">
    <div class="nav-brand">
        <img src="~/images/logo3.png" alt="Dar Oasis" />
    </div>
    <div style="display:flex;align-items:center;gap:14px;">
        <span class="nav-role">
            @(Context.Session.GetString("UserRole") == "gerant" ? "Gérant" : "Réceptionniste")
        </span>
        <span style="font-size:13px;color:#6B4423;font-weight:700;">
            @Context.Session.GetString("UserNom")
        </span>
      
        <a href="/Auth/Logout" class="btn-logout">Déconnexion</a>
    </div>
</nav>

<!-- LAYOUT -->
<div class="layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        @if (Context.Session.GetString("UserRole") == "gerant")
        {
            <div class="sidebar-section">Tableau de bord</div>
            <a href="/Dashboard/Index" class="sidebar-item">
                <span class="sidebar-icon icon-brown">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#5C3317" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                </span>Dashboard
            </a>

            <div class="sidebar-section">Gestion</div>
            <a href="/Clients/Index" class="sidebar-item">
                <span class="sidebar-icon icon-olive">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#6B7C3E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                </span>Clients
            </a>
            <a href="/Chambres/Index" class="sidebar-item">
                <span class="sidebar-icon icon-mustard">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#C8922A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </span>Chambres
            </a>
            <a href="/Reservations/Index" class="sidebar-item">
                <span class="sidebar-icon icon-terra">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#C47A5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>Réservations
            </a>
             <a href="/ServiceSupplementaires/Index" class="sidebar-item">
                <span class="sidebar-icon icon-mustard">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#C8922A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
                </span>Services
            </a>
            <a href="/Factures/Index" class="sidebar-item">
                <span class="sidebar-icon icon-mustard">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#C8922A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
                </span>Factures
            </a>

            <div class="sidebar-section">Personnel</div>
            <a href="/Employes/Index" class="sidebar-item">
                <span class="sidebar-icon icon-olive">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#6B7C3E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/><path d="M21 21v-2a4 4 0 0 0-3-3.85"/></svg>
                </span>Employés
            </a>
            <a href="/Affectations/Index" class="sidebar-item">
                <span class="sidebar-icon icon-brown">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#5C3317" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                </span>Affectations
            </a>
            

            
           
        }
        else
        {
             <div class="sidebar-section">Tableau de bord</div>
            <a href="/Dashboard/Index" class="sidebar-item">
                <span class="sidebar-icon icon-brown">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#5C3317" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                </span>Dashboard
            </a>
            <div class="sidebar-section">Accueil</div>
            <a href="/Chambres/Index" class="sidebar-item">
                <span class="sidebar-icon icon-mustard">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#C8922A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </span>Chambres
            </a>
            <a href="/Clients/Index" class="sidebar-item">
                <span class="sidebar-icon icon-olive">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#6B7C3E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                </span>Clients
            </a>
            <a href="/Reservations/Index" class="sidebar-item">
                <span class="sidebar-icon icon-terra">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#C47A5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>Réservations
            </a>
            <a href="/Factures/Index" class="sidebar-item">
                <span class="sidebar-icon icon-brown">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#5C3317" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </span>Factures
            </a>
            <div class="sidebar-section">Extras</div>
            <a href="/ServiceSupplementaires/Index" class="sidebar-item">
                <span class="sidebar-icon icon-mustard">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#C8922A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
                </span>Services
            </a>
        }
    </aside>

    <!-- CONTENU PRINCIPAL -->
    <main class="main-content">
        @RenderBody()
    </main>

</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>